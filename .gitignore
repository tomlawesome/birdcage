birdcage.db

# The frontend build (frontend/npm run build) is copied here for
# web/embed.go's //go:embed all:dist to pick up -- nothing built is
# committed, only the placeholder .gitkeep the embed pattern needs to
# compile against an unbuilt checkout.
/web/dist/*
!/web/dist/.gitkeep

# Agent worktrees the harness creates under the checkout; never part of the project.
/.claude/worktrees/

# Session handoffs the agents write under the checkout; never part of the project (owner, 2026-09-14).
/.agents/
